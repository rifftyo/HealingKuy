<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/bg_dialog">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Edit Profile"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_bold"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_edit_profile"
        android:layout_width="175dp"
        android:layout_height="175dp"
        app:civ_border_color="#000000"
        app:civ_border_width="3dp"
        tools:src="@drawable/img_traveling"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/btn_edit_profile"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:contentDescription="Edit profile"
        android:padding="8dp"
        android:src="@drawable/edit_icon"
        app:layout_constraintBottom_toBottomOf="@id/img_edit_profile"
        app:layout_constraintEnd_toEndOf="@id/img_edit_profile" />

    <TextView
        android:id="@+id/tv_new_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_edit_profile"
        android:text="Username Baru"
        android:fontFamily="@font/poppins_medium"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/usernameEditTextLayout"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:hintEnabled="false"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#000000"
        app:boxCornerRadiusTopStart="25dp"
        app:boxCornerRadiusTopEnd="25dp"
        app:boxCornerRadiusBottomEnd="25dp"
        app:boxCornerRadiusBottomStart="25dp"
        app:boxBackgroundColor="@color/white"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_new_username"
        app:layout_constraintStart_toStartOf="@id/tv_new_username"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/usernameEditText"
            android:layout_width="match_parent"
            android:fontFamily="@font/poppins_regular"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingStart="20dp"
            android:hint="Username Baru"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_update"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_marginTop="35dp"
        android:text="Perbarui Profil"
        android:textSize="12sp"
        android:backgroundTint="@color/black"
        android:textAllCaps="false"
        app:cornerRadius="35dp"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintTop_toBottomOf="@id/usernameEditTextLayout"
        app:layout_constraintStart_toStartOf="@id/usernameEditTextLayout"
        app:layout_constraintEnd_toEndOf="@id/usernameEditTextLayout"/>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/black"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/btn_update"
        app:layout_constraintBottom_toBottomOf="@id/btn_update"
        app:layout_constraintStart_toStartOf="@id/btn_update"
        app:layout_constraintEnd_toEndOf="@id/btn_update"/>

</androidx.constraintlayout.widget.ConstraintLayout>
