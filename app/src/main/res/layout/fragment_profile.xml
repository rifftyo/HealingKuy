<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.profile.ProfileFragment">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_profile"
        android:layout_width="175dp"
        android:layout_height="175dp"
        tools:src="@drawable/img_traveling"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tv_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Jajang"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginTop="16dp"
        android:textSize="24sp"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/img_profile"
        app:layout_constraintStart_toStartOf="@id/img_profile"
        app:layout_constraintEnd_toEndOf="@id/img_profile"/>

    <TextView
        android:id="@+id/tv_change_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profil"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        android:layout_marginTop="36dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_username"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/img_change_profile"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_change_profile"
        app:layout_constraintBottom_toBottomOf="@id/tv_change_profile"
        android:src="@drawable/arrow_right"/>

    <TextView
        android:id="@+id/tv_app_setting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Setting Aplikasi"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_change_profile"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/img_change_setting"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_app_setting"
        app:layout_constraintBottom_toBottomOf="@id/tv_app_setting"
        android:src="@drawable/arrow_right"/>

    <TextView
        android:id="@+id/tv_change_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ganti Bahasa"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_app_setting"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/img_change_language"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_change_language"
        app:layout_constraintBottom_toBottomOf="@id/tv_change_language"
        android:src="@drawable/arrow_right"/>

    <TextView
        android:id="@+id/tv_change_theme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ganti Tema"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_change_language"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/img_change_theme"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_change_theme"
        app:layout_constraintBottom_toBottomOf="@id/tv_change_theme"
        android:src="@drawable/arrow_right"/>

    <TextView
        android:id="@+id/tv_change_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ganti Email"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_change_theme"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/img_change_email"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_change_email"
        app:layout_constraintBottom_toBottomOf="@id/tv_change_email"
        android:src="@drawable/arrow_right"/>

    <TextView
        android:id="@+id/tv_change_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ganti Password"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_change_email"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/img_change_password"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/tv_change_password"
        app:layout_constraintBottom_toBottomOf="@id/tv_change_password"
        android:src="@drawable/arrow_right"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_logout"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_marginBottom="25dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:text="Keluar"
        android:textSize="16sp"
        android:backgroundTint="@color/red"
        android:textAllCaps="false"
        app:cornerRadius="35dp"
        android:fontFamily="@font/poppins_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="5dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>